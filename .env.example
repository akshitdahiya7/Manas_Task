# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored - never commit real secrets.

# --- Database -----------------------------------------------------------
# Credentials the Postgres container is created with.
POSTGRES_USER=manas
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=manas

# Connection string for a LOCAL (non-Docker) run: SQLite needs no server.
# docker-compose overrides DATABASE_URL with the Postgres URL built from the
# POSTGRES_* values above, so this line is only used outside Docker.
DATABASE_URL=sqlite:///./manas.db

# --- Auth ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Seeded demo accounts. Change the passwords before exposing this anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me-viewer

# --- Host ports (change if these are already in use) ---------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Limits / behaviour -------------------------------------------------
ENVIRONMENT=development
MAX_BATCH_ROWS=1000
MAX_UPLOAD_BYTES=5242880

# Prediction-drift proxy (training data was a balanced 50/50 split).
DRIFT_BASELINE_POSITIVE_RATE=0.5
DRIFT_WINDOW=200
DRIFT_THRESHOLD=0.15
